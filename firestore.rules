rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isVerified() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function isMainAdmin() {
      return isVerified()
        && request.auth.token.email.lower() == 'shriharishcrackerswebsite@gmail.com';
    }

    function isAdmin() {
      return isMainAdmin()
        || (isVerified() && exists(/databases/$(database)/documents/adminAccess/$(request.auth.token.email.lower())));
    }

    function validName(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120;
    }

    function validPrice(data) {
      return data.price is number
        && data.price >= 0
        && data.active is bool
        && (
          !('originalPrice' in data)
          || data.originalPrice == null
          || (data.originalPrice is number && data.originalPrice >= 0 && data.originalPrice >= data.price)
        );
    }

    function validLog(data) {
      return data.keys().hasOnly(['adminName', 'adminEmail', 'action', 'targetType', 'targetId', 'targetName', 'oldValue', 'newValue', 'createdAt'])
        && data.adminName is string
        && data.adminName.size() > 0
        && data.adminName.size() <= 80
        && data.adminEmail == request.auth.token.email.lower()
        && data.action in ['create', 'update', 'delete', 'grant-admin', 'revoke-admin']
        && data.targetType in ['products', 'productList', 'adminAccess', 'orders']
        && data.targetId is string
        && data.targetId.size() > 0
        && data.targetId.size() <= 200
        && data.targetName is string
        && data.targetName.size() <= 120
        && (data.oldValue == null || data.oldValue is map)
        && (data.newValue == null || data.newValue is map)
        && data.createdAt == request.time;
    }

    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update: if isAdmin()
        && validName(request.resource.data)
        && validPrice(request.resource.data);
      allow delete: if isAdmin();
    }

    match /productList/{itemId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update: if isAdmin()
        && validName(request.resource.data)
        && validPrice(request.resource.data);
      allow delete: if isAdmin();
    }

    match /adminAccess/{emailId} {
      allow get: if isMainAdmin()
        || (isVerified() && request.auth.token.email.lower() == emailId);
      allow list: if isMainAdmin();
      allow create: if isMainAdmin()
        && emailId == request.resource.data.email
        && emailId != 'shriharishcrackerswebsite@gmail.com'
        && emailId.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,}$')
        && emailId.size() <= 120
        && request.resource.data.keys().hasOnly(['email', 'grantedBy', 'createdAt'])
        && request.resource.data.grantedBy == request.auth.token.email.lower()
        && request.resource.data.createdAt == request.time;
      allow delete: if isMainAdmin()
        && emailId != 'shriharishcrackerswebsite@gmail.com';
      allow update: if false;
    }

    function validExitEnquiry(data) {
      return data.keys().hasOnly(['name', 'phone', 'source', 'status', 'createdAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.phone is string
        && data.phone.matches('^(\\+91)?[6-9]\\d{9}$')
        && data.source == 'exit_popup'
        && data.status == 'submitted'
        && data.createdAt == request.time;
    }

    function validOrderItem(item) {
      return item is map
        && item.keys().hasOnly(['id', 'name', 'quantity', 'price'])
        && item.id is string
        && item.id.size() > 0
        && item.id.size() <= 120
        && item.name is string
        && item.name.size() > 0
        && item.name.size() <= 120
        && item.quantity is int
        && item.quantity > 0
        && item.quantity <= 999
        && item.price is int
        && item.price >= 0;
    }

    function validOrder(data) {
      return data.keys().hasOnly(['customerName', 'phone', 'address', 'source', 'items', 'total', 'status', 'createdAt', 'updatedAt'])
        && data.customerName is string
        && data.customerName.size() > 0
        && data.customerName.size() <= 120
        && data.phone is string
        && data.phone.matches('^(\\+91)?[6-9]\\d{9}$')
        && data.address is string
        && data.address.size() <= 240
        && data.source in ['products', 'productList']
        && data.items is list
        && data.items.size() > 0
        && data.items.size() <= 40
        && validOrderItem(data.items[0])
        && data.total is int
        && data.total >= 0
        && data.status == 'received'
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    match /orders/{orderId} {
      allow get: if isAdmin() || resource.data.status is string;
      allow list: if isAdmin();
      allow create: if validOrder(request.resource.data);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['received', 'confirmed', 'completed', 'cancelled']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /exitEnquiries/{enquiryId} {
      allow create: if validExitEnquiry(request.resource.data);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validLog(request.resource.data);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
